{
  "name": "tower-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "format": "prettier --write src docs README.md CLAUDE.md index.html vite.config.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
